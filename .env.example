# Local EIA ingestion only. Do not set this on a public API.
# Register at https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Browser origins for a future public API. The 2026-11-03 retirement removed
# the previous hosted origin. A wildcard is rejected. Leave this unset for
# same-machine server-side calls and for local development.
# INFRALENS_CORS_ORIGINS=https://YOUR-PROJECT.vercel.app

# Optional. The container sets this to /app. A local portable simulation points
# at a directory that contains docs/final_eia_holdout_oneshot.json and not data/.
# INFRALENS_ROOT=

# Extra exact hosts for a future hosted API. A wildcard or malformed host is rejected.
# The retired private service had no RENDER_EXTERNAL_HOSTNAME. A replacement
# would set the public API hostname here when RENDER=true.
# Example placeholder only: api.example.com
# INFRALENS_ALLOWED_HOSTS=
# Application request bound in seconds. Unset leaves the limit off.
# This is not Uvicorn's keep-alive and not a proxy read timeout.
# INFRALENS_REQUEST_TIMEOUT_SECONDS=30
