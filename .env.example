# Local EIA ingestion only. Do not set this on the public API.
# Register at https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Public API. Replace the origin with the real Vercel production origin.
# A wildcard is rejected. Leave this unset for same-machine server-side calls.
# INFRALENS_CORS_ORIGINS=https://YOUR-PROJECT.vercel.app

# Optional. The container sets this to /app. A local portable simulation points
# at a directory that contains docs/final_eia_holdout_oneshot.json and not data/.
# INFRALENS_ROOT=

# Extra exact hosts. A wildcard or malformed host is rejected.
# A private Render service has no RENDER_EXTERNAL_HOSTNAME. Set the Cloudflare
# hostname here when RENDER=true. Example placeholder: api.example.com
# INFRALENS_ALLOWED_HOSTS=
# Application request bound in seconds. Unset leaves the limit off.
# This is not Uvicorn's keep-alive and not Cloudflare's proxy read timeout.
# INFRALENS_REQUEST_TIMEOUT_SECONDS=30
