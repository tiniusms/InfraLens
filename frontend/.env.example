# Base URL of the read-only InfraLens API. No EIA key belongs here.
# Supported local API. An unset client value also resolves to this origin.
VITE_API_BASE_URL=http://127.0.0.1:8000
# A future public build would set an https API origin, with no path and no secret.
# The November 3, 2026 public hosts are retired. Do not restore a deleted hostname here.
# VITE_API_BASE_URL=https://api.example.com
# An explicit empty value would call same-origin /api. This package does not proxy /api.

# Start the API with an explicit origin allowlist. Wildcard origins are rejected.
# INFRALENS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# uvicorn infralens.api.app:app --app-dir src
